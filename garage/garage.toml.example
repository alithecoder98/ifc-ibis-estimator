# Template for local-dev Garage config (S3-compatible object storage).
# Copy to garage.toml (git-ignored — it holds generated secrets) and replace the two
# secrets below, e.g.:
#   openssl rand -hex 32
#
# Garage is self-hosted and EU-hostable, so this same setup can carry forward into
# staging/production storage later, not just local dev.

metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_OPENSSL_RAND_HEX_32"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REPLACE_WITH_OPENSSL_RAND_HEX_32"
