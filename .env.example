# Shared local-dev infrastructure config, consumed by docker-compose.yml.
# Copy to .env (git-ignored) and adjust if needed — the defaults work out of the box.

POSTGRES_USER=ifc_ibis
POSTGRES_PASSWORD=ifc_ibis_dev
POSTGRES_DB=ifc_ibis
POSTGRES_PORT=5432

REDIS_PORT=6379

# S3-compatible storage (Garage — see garage/garage.toml.example to generate its secrets)
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
