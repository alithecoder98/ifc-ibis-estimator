# Copy to .env (git-ignored). Defaults match the root docker-compose.yml services.

DATABASE_URL=postgresql+psycopg://ifc_ibis:ifc_ibis_dev@localhost:5432/ifc_ibis
REDIS_URL=redis://localhost:6379/0

# Object storage (Garage locally — self-hosted, EU-hostable; access key/secret are
# created once via `garage key create` + `garage bucket allow`, see Phase 2.1)
S3_ENDPOINT_URL=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ifc-uploads
S3_REGION=garage

# Auth
JWT_SECRET=change-me-in-every-environment-min-32-bytes
JWT_EXPIRES_MINUTES=60
# Dev-only convenience: every request becomes a fixed admin user (dev@local.test), no
# login needed. Leave unset/false normally. The app refuses to start if this is true
# and ENVIRONMENT isn't "development" - never set this outside local dev.
AUTH_DISABLED=false

# AI providers
# Local/open-source models via docker-compose's ollama service (Phase 3, decided
# 2026-10-13) - no API key. Pull models once: `docker compose exec ollama ollama pull
# bge-m3` and `... ollama pull qwen2.5:7b-instruct`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# jev — left unset until the client's real API docs/access arrive; app must run
# without it (sees a stub) until then.
JEV_API_URL=
JEV_API_KEY=

ENVIRONMENT=development
