# Client-provided reference files and generated reports — never committed.
/data/*
!/data/README.md

# Internal Claude Code session log (environment quirks, decision history) — kept
# locally for picking the project back up, deliberately left out of the public repo
# (see README.md/CHANGELOG.md for the project-facing documentation instead).
/CLAUDE.md

# Local env files (every app has its own; .env.example is the template that IS committed)
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db

# Ad-hoc local dev server output (redirected stdout/stderr when running servers
# outside docker-compose, e.g. `uv run uvicorn ... > .api_dev.log`)
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Garage (local S3-compatible storage) — generated secrets + data volumes
/garage/garage.toml
/garage/data/
/garage/meta/
